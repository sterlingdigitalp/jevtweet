# Export these in your shell. The app does not automatically load dotenv files.
TYPESAFE_API_KEY=
# Live calls require an explicit positive ceiling. Persistent reservations live in the private DB.
JEVTWEET_SPEND_LIMIT_USD=0
JEVTWEET_DATA_DIR=private
# Shared across all local corpora/processes using this account; do not reset between jobs.
# Optional absolute path shared by all installations; default is this installation’s private/account.
# JEVTWEET_ACCOUNT_DIR=/absolute/private/path/account
JEVTWEET_CONCURRENCY=2
JEVTWEET_REQUESTS_PER_MINUTE=30
JEVTWEET_TIMEOUT_SECONDS=45
JEVTWEET_MAX_ATTEMPTS=3
JEVTWEET_MAX_ROWS=1000
JEVTWEET_MAX_REQUEST_TOKENS=24000
JEVTWEET_MAX_STATE_QUESTION_TOKENS=16000
